@page "/pacientes"
@rendermode InteractiveServer
@inject IPacienteRepository PacienteRepository
@inject IEpsRepository EpsRepository

<PageTitle>Gestión de Pacientes - IPS SaaS</PageTitle>

<div class="space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
        <div>
            <div class="flex items-center gap-2">
                <span class="p-2 rounded-xl bg-sky-50 text-sky-600 text-xl font-bold">
                    <i class="bi bi-people-fill"></i>
                </span>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Gestión de Pacientes</h1>
            </div>
            <p class="text-xs text-slate-500 mt-1">Registro demográfico con primer/segundo nombre y apellidos (Normativa Minsalud Colombia)</p>
        </div>
        <button class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-semibold text-sm shadow-lg shadow-sky-600/20 transition-all hover:scale-[1.02] active:scale-[0.98]" @onclick="AbrirFormularioNuevo">
            <i class="bi bi-person-plus-fill"></i> Registrar Paciente
        </button>
    </div>

    <!-- Notifications -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="flex items-center justify-between p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium">
            <div class="flex items-center gap-2">
                <i class="bi bi-check-circle-fill text-emerald-600 text-lg"></i>
                <span>@mensajeExito</span>
            </div>
            <button class="text-emerald-600 hover:text-emerald-800 font-bold" @onclick="() => mensajeExito = null">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="flex items-center justify-between p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-medium">
            <div class="flex items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-red-600 text-lg"></i>
                <span>@mensajeError</span>
            </div>
            <button class="text-red-600 hover:text-red-800 font-bold" @onclick="() => mensajeError = null">×</button>
        </div>
    }

    <!-- Form Section -->
    @if (mostrarFormulario)
    {
        <div class="bg-white rounded-2xl border border-sky-200 shadow-xl overflow-hidden ring-4 ring-sky-500/10">
            <div class="bg-gradient-to-r from-sky-600 to-indigo-600 px-6 py-4 text-white flex items-center justify-between">
                <h3 class="font-bold text-base flex items-center gap-2">
                    <i class="bi bi-person-lines-fill"></i> Registro Demográfico de Paciente
                </h3>
                <button type="button" class="text-white/80 hover:text-white font-bold text-xl" @onclick="CancelarFormulario">×</button>
            </div>
            <div class="p-6">
                <EditForm Model="@modelo" OnValidSubmit="GuardarPaciente">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold" />

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Tipo Documento *</label>
                            <InputSelect class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.TipoDocumento">
                                @foreach (var tipo in Enum.GetValues<TipoDocumento>())
                                {
                                    <option value="@tipo">@tipo</option>
                                }
                            </InputSelect>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Número Documento *</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.NumeroDocumento" placeholder="Ej: 10203040" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Primer Nombre *</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.PrimerNombre" placeholder="Primer nombre" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Segundo Nombre</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.SegundoNombre" placeholder="Segundo nombre (opcional)" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Primer Apellido *</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.PrimerApellido" placeholder="Primer apellido" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Segundo Apellido</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.SegundoApellido" placeholder="Segundo apellido (opcional)" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Fecha Nacimiento *</label>
                            <InputDate class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.FechaNacimiento" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Género *</label>
                            <InputSelect class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.Genero">
                                @foreach (var gen in Enum.GetValues<Genero>())
                                {
                                    <option value="@gen">@gen</option>
                                }
                            </InputSelect>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Entidad EPS *</label>
                            <InputSelect class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.EpsId">
                                <option value="0">-- Seleccionar EPS --</option>
                                @if (epsList != null)
                                {
                                    @foreach (var eps in epsList)
                                    {
                                        <option value="@eps.Id">@eps.Nombre (@eps.Codigo)</option>
                                    }
                                }
                            </InputSelect>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Régimen Salud *</label>
                            <InputSelect class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.RegimenSalud">
                                @foreach (var reg in Enum.GetValues<RegimenSalud>())
                                {
                                    <option value="@reg">@reg</option>
                                }
                            </InputSelect>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Teléfono Movil</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.Telefono" placeholder="300 000 0000" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Correo Electrónico</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" @bind-Value="modelo.Email" placeholder="paciente@correo.com" />
                        </div>
                    </div>

                    <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-slate-100">
                        <button type="button" class="px-4 py-2 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100 transition-colors" @onclick="CancelarFormulario">Cancelar</button>
                        <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-md shadow-emerald-600/20 transition-all flex items-center gap-2">
                            <i class="bi bi-save"></i> Guardar Paciente
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-slate-50/50">
            <h2 class="font-bold text-slate-900 text-base">Pacientes Registrados en la IPS</h2>
            <div class="relative w-full sm:w-72">
                <i class="bi bi-search absolute left-3.5 top-2.5 text-slate-400 text-sm"></i>
                <input type="text" class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 bg-white text-sm focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 outline-none transition-all" placeholder="Buscar por documento o nombre..." @bind="busqueda" @bind:event="oninput" @onkeyup="FiltrarPacientes" />
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-100/70 border-b border-slate-200/60 text-slate-500 font-bold uppercase text-[11px] tracking-wider">
                        <th class="py-3.5 px-4">Documento</th>
                        <th class="py-3.5 px-4">Nombre Completo del Paciente</th>
                        <th class="py-3.5 px-4">Nacimiento</th>
                        <th class="py-3.5 px-4">Género</th>
                        <th class="py-3.5 px-4">EPS</th>
                        <th class="py-3.5 px-4">Régimen</th>
                        <th class="py-3.5 px-4">Contacto</th>
                        <th class="py-3.5 px-4 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @if (pacientes == null)
                    {
                        <tr><td colspan="8" class="p-8 text-center text-slate-400">Cargando datos de pacientes...</td></tr>
                    }
                    else if (!pacientes.Any())
                    {
                        <tr><td colspan="8" class="p-8 text-center text-slate-400">No se encontraron pacientes registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in pacientes)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-3.5 px-4 font-mono font-medium">
                                    <span class="inline-block px-2 py-0.5 rounded bg-slate-200 text-slate-700 text-xs font-bold mr-1.5">@p.TipoDocumento</span>
                                    <span>@p.NumeroDocumento</span>
                                </td>
                                <td class="py-3.5 px-4 font-semibold text-slate-900">@p.NombreCompleto</td>
                                <td class="py-3.5 px-4">
                                    <span class="text-xs text-slate-600">@p.FechaNacimiento.ToString("dd/MM/yyyy") (@p.Edad años)</span>
                                </td>
                                <td class="py-3.5 px-4">@p.Genero</td>
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-sky-50 text-sky-700 font-semibold text-xs border border-sky-200/60">
                                        @p.EpsNombre
                                    </span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 font-medium text-xs">
                                        @p.RegimenSalud
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-xs text-slate-500">
                                    <div><i class="bi bi-telephone"></i> @(string.IsNullOrEmpty(p.Telefono) ? "N/A" : p.Telefono)</div>
                                    @if (!string.IsNullOrEmpty(p.Email))
                                    {
                                        <div class="text-[11px] text-slate-400 truncate max-w-[150px]">@p.Email</div>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">@p.Estado</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<PacienteDto>? pacientes;
    private List<EpsDto>? epsList;
    private bool mostrarFormulario = false;
    private CreatePacienteRequest modelo = new();
    private string? busqueda;
    private string? mensajeExito;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarEPS();
        await CargarPacientes();
    }

    private async Task CargarEPS()
    {
        var res = await EpsRepository.GetAllAsync();
        if (res.IsSuccess && res.Value != null)
        {
            epsList = res.Value.ToList();
        }
    }

    private async Task CargarPacientes()
    {
        var res = await PacienteRepository.SearchAsync(busqueda ?? string.Empty);
        if (res.IsSuccess && res.Value != null)
        {
            pacientes = res.Value.ToList();
        }
        else
        {
            mensajeError = res.Error;
        }
    }

    private async Task FiltrarPacientes()
    {
        await CargarPacientes();
    }

    private void AbrirFormularioNuevo()
    {
        modelo = new CreatePacienteRequest();
        if (epsList != null && epsList.Any())
        {
            modelo.EpsId = epsList.First().Id;
        }
        mostrarFormulario = true;
        mensajeExito = null;
        mensajeError = null;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task GuardarPaciente()
    {
        if (modelo.EpsId <= 0)
        {
            mensajeError = "Debe seleccionar una EPS válida.";
            return;
        }

        var res = await PacienteRepository.CreateAsync(modelo);
        if (res.IsSuccess && res.Value != null)
        {
            mensajeExito = $"Paciente {res.Value.NombreCompleto} registrado correctamente.";
            mostrarFormulario = false;
            await CargarPacientes();
        }
        else
        {
            mensajeError = res.Error;
        }
    }
}
