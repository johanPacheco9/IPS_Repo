@page "/"
@rendermode InteractiveServer
@inject IPacienteRepository PacienteRepository
@inject IProfesionalRepository ProfesionalRepository
@inject ICitaRepository CitaRepository
@inject IAdmisionRepository AdmisionRepository

<PageTitle>Dashboard - IPS SaaS Colombia</PageTitle>

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 via-sky-950 to-slate-900 p-8 text-white shadow-xl">
        <div class="relative z-10 max-w-3xl">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 px-3 py-1 text-xs font-semibold text-sky-300 backdrop-blur-md">
                <i class="bi bi-shield-check"></i> Cumplimiento Normativo Colombia
            </span>
            <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                Plataforma SaaS de Gestión IPS
            </h1>
            <p class="mt-2 text-slate-300 text-sm sm:text-base leading-relaxed">
                Control completo de Pacientes, Talento Humano RETHUS, Agendamiento de Citas, Admisiones con Copagos y Facturación Electrónica DIAN / RIPS Res. 2275.
            </p>
        </div>
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Stat 1: Pacientes -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Pacientes</span>
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold text-xl">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <p class="text-3xl font-extrabold text-slate-900 mt-4">@totalPacientes</p>
            <div class="mt-2 flex items-center gap-1.5 text-xs text-emerald-600 font-medium">
                <i class="bi bi-arrow-up-right"></i>
                <span>@pacientesActivos Activos en sistema</span>
            </div>
        </div>

        <!-- Stat 2: Médicos RETHUS -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Médicos RETHUS</span>
                <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
            </div>
            <p class="text-3xl font-extrabold text-slate-900 mt-4">@totalProfesionales</p>
            <div class="mt-2 flex items-center gap-1.5 text-xs text-indigo-600 font-medium">
                <i class="bi bi-check-circle-fill"></i>
                <span>Talento Humano Verificado</span>
            </div>
        </div>

        <!-- Stat 3: Citas Agendadas -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Citas Programadas</span>
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-xl">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
            </div>
            <p class="text-3xl font-extrabold text-slate-900 mt-4">@totalCitas</p>
            <div class="mt-2 flex items-center gap-1.5 text-xs text-amber-600 font-medium">
                <i class="bi bi-clock-history"></i>
                <span>@citasHoy citas para hoy</span>
            </div>
        </div>

        <!-- Stat 4: Admisiones / Check-in -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Admisiones Recientes</span>
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl">
                    <i class="bi bi-journal-check"></i>
                </div>
            </div>
            <p class="text-3xl font-extrabold text-slate-900 mt-4">@totalAdmisiones</p>
            <div class="mt-2 flex items-center gap-1.5 text-xs text-emerald-600 font-medium">
                <i class="bi bi-shield-check"></i>
                <span>Flujo Check-in Activo</span>
            </div>
        </div>
    </div>

    <!-- Quick Actions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="pacientes" class="group bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs hover:border-sky-500 hover:shadow-lg transition-all flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 group-hover:bg-sky-600 group-hover:text-white transition-colors flex items-center justify-center text-2xl font-bold">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <div>
                <h3 class="font-bold text-slate-900 group-hover:text-sky-600 transition-colors">Registrar Paciente</h3>
                <p class="text-xs text-slate-500 mt-1">Captura completa de datos demográficos y EPS.</p>
            </div>
        </a>

        <a href="agendamiento" class="group bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs hover:border-sky-500 hover:shadow-lg transition-all flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 group-hover:bg-amber-600 group-hover:text-white transition-colors flex items-center justify-center text-2xl font-bold">
                <i class="bi bi-calendar-plus-fill"></i>
            </div>
            <div>
                <h3 class="font-bold text-slate-900 group-hover:text-sky-600 transition-colors">Agendar Cita Médica</h3>
                <p class="text-xs text-slate-500 mt-1">Asignación de disponabilidades por profesional.</p>
            </div>
        </a>

        <a href="admisiones" class="group bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs hover:border-sky-500 hover:shadow-lg transition-all flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors flex items-center justify-center text-2xl font-bold">
                <i class="bi bi-check-square-fill"></i>
            </div>
            <div>
                <h3 class="font-bold text-slate-900 group-hover:text-sky-600 transition-colors">Admisión / Check-in</h3>
                <p class="text-xs text-slate-500 mt-1">Validación de convenios EPS y cobro de copagos.</p>
            </div>
        </a>
    </div>
</div>

@code {
    private int totalPacientes = 0;
    private int pacientesActivos = 0;
    private int totalProfesionales = 0;
    private int totalCitas = 0;
    private int citasHoy = 0;
    private int totalAdmisiones = 0;

    protected override async Task OnInitializedAsync()
    {
        var resPacientes = await PacienteRepository.GetAllAsync();
        if (resPacientes.IsSuccess && resPacientes.Value != null)
        {
            totalPacientes = resPacientes.Value.Count;
            pacientesActivos = resPacientes.Value.Count(p => p.Estado == EstadoPaciente.Activo);
        }

        var resProfs = await ProfesionalRepository.GetAllAsync();
        if (resProfs.IsSuccess && resProfs.Value != null)
        {
            totalProfesionales = resProfs.Value.Count;
        }

        var resCitas = await CitaRepository.GetByEstadoAsync(EstadoCita.Programada);
        if (resCitas.IsSuccess && resCitas.Value != null)
        {
            totalCitas = resCitas.Value.Count;
            citasHoy = resCitas.Value.Count(c => c.FechaHora.Date == DateTime.Today);
        }

        var resAdms = await AdmisionRepository.GetAllAsync();
        if (resAdms.IsSuccess && resAdms.Value != null)
        {
            totalAdmisiones = resAdms.Value.Count;
        }
    }
}