@page "/profesionales"
@rendermode InteractiveServer
@inject IProfesionalRepository ProfesionalRepository

<PageTitle>Profesionales de la Salud - IPS SaaS</PageTitle>

<div class="space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
        <div>
            <div class="flex items-center gap-2">
                <span class="p-2 rounded-xl bg-indigo-50 text-indigo-600 text-xl font-bold">
                    <i class="bi bi-person-badge-fill"></i>
                </span>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Médicos y Especialistas (RETHUS)</h1>
            </div>
            <p class="text-xs text-slate-500 mt-1">Gestión del Registro Único Nacional del Talento Humano en Salud con nombres y apellidos independientes</p>
        </div>
        <button class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-lg shadow-indigo-600/20 transition-all hover:scale-[1.02] active:scale-[0.98]" @onclick="AbrirFormularioNuevo">
            <i class="bi bi-person-plus-fill"></i> Registrar Profesional
        </button>
    </div>

    <!-- Notifications -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="flex items-center justify-between p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium">
            <div class="flex items-center gap-2">
                <i class="bi bi-check-circle-fill text-emerald-600 text-lg"></i>
                <span>@mensajeExito</span>
            </div>
            <button class="text-emerald-600 hover:text-emerald-800 font-bold" @onclick="() => mensajeExito = null">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="flex items-center justify-between p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-medium">
            <div class="flex items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-red-600 text-lg"></i>
                <span>@mensajeError</span>
            </div>
            <button class="text-red-600 hover:text-red-800 font-bold" @onclick="() => mensajeError = null">×</button>
        </div>
    }

    <!-- Form Section -->
    @if (mostrarFormulario)
    {
        <div class="bg-white rounded-2xl border border-indigo-200 shadow-xl overflow-hidden ring-4 ring-indigo-500/10">
            <div class="bg-gradient-to-r from-indigo-600 to-sky-600 px-6 py-4 text-white flex items-center justify-between">
                <h3 class="font-bold text-base flex items-center gap-2">
                    <i class="bi bi-shield-check"></i> Registro de Talento Humano en Salud (RETHUS)
                </h3>
                <button type="button" class="text-white/80 hover:text-white font-bold text-xl" @onclick="CancelarFormulario">×</button>
            </div>
            <div class="p-6">
                <EditForm Model="@modelo" OnValidSubmit="GuardarProfesional">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold" />

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Tipo Documento *</label>
                            <InputSelect class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.TipoDocumento">
                                @foreach (var tipo in Enum.GetValues<TipoDocumento>())
                                {
                                    <option value="@tipo">@tipo</option>
                                }
                            </InputSelect>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Número Documento *</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.NumeroDocumento" placeholder="Cédula de ciudadanía" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Primer Nombre *</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.PrimerNombre" placeholder="Primer nombre del médico" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Segundo Nombre</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.SegundoNombre" placeholder="Segundo nombre" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Primer Apellido *</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.PrimerApellido" placeholder="Primer apellido" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Segundo Apellido</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.SegundoApellido" placeholder="Segundo apellido" />
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold uppercase tracking-wider text-amber-700 mb-1">
                                <i class="bi bi-shield-lock-fill"></i> Número RETHUS * (Ley Colombia)
                            </label>
                            <InputText class="w-full rounded-xl border border-amber-300 bg-amber-50/40 px-3.5 py-2 text-sm font-mono font-bold text-amber-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none transition-all" @bind-Value="modelo.NumeroRethus" placeholder="Ej: RETHUS-10293847" />
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Especialidad Médica *</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.Especialidad" placeholder="Ej: Medicina General, Pediatría, Cardiología" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Teléfono</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.Telefono" placeholder="300 000 0000" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Email Profesional</label>
                            <InputText class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all" @bind-Value="modelo.Email" placeholder="medico@ips.com" />
                        </div>
                    </div>

                    <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-slate-100">
                        <button type="button" class="px-4 py-2 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100 transition-colors" @onclick="CancelarFormulario">Cancelar</button>
                        <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-md shadow-indigo-600/20 transition-all flex items-center gap-2">
                            <i class="bi bi-save"></i> Guardar Profesional
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
        <div class="p-5 border-b border-slate-100 bg-slate-50/50">
            <h2 class="font-bold text-slate-900 text-base">Talento Humano Registrado</h2>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-100/70 border-b border-slate-200/60 text-slate-500 font-bold uppercase text-[11px] tracking-wider">
                        <th class="py-3.5 px-4">Documento</th>
                        <th class="py-3.5 px-4">Nombre del Profesional</th>
                        <th class="py-3.5 px-4">Registro RETHUS</th>
                        <th class="py-3.5 px-4">Especialidad</th>
                        <th class="py-3.5 px-4">Contacto</th>
                        <th class="py-3.5 px-4 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @if (profesionales == null)
                    {
                        <tr><td colspan="6" class="p-8 text-center text-slate-400">Cargando profesionales de la salud...</td></tr>
                    }
                    else if (!profesionales.Any())
                    {
                        <tr><td colspan="6" class="p-8 text-center text-slate-400">No se encontraron profesionales registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in profesionales)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-3.5 px-4 font-mono font-medium">@p.TipoDocumento @p.NumeroDocumento</td>
                                <td class="py-3.5 px-4 font-semibold text-slate-900">@p.NombreCompleto</td>
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-50 text-amber-800 font-mono font-bold text-xs border border-amber-200">
                                        <i class="bi bi-shield-check text-amber-600"></i> @p.NumeroRethus
                                    </span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 font-semibold text-xs">
                                        @p.Especialidad
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-xs text-slate-500">
                                    <div><i class="bi bi-telephone"></i> @(string.IsNullOrEmpty(p.Telefono) ? "N/A" : p.Telefono)</div>
                                    @if (!string.IsNullOrEmpty(p.Email))
                                    {
                                        <div class="text-[11px] text-slate-400">@p.Email</div>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (p.Activo)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-red-100 text-red-800 text-xs font-bold">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ProfesionalDto>? profesionales;
    private bool mostrarFormulario = false;
    private CreateProfesionalRequest modelo = new();
    private string? mensajeExito;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarProfesionales();
    }

    private async Task CargarProfesionales()
    {
        var res = await ProfesionalRepository.GetAllAsync();
        if (res.IsSuccess && res.Value != null)
        {
            profesionales = res.Value.ToList();
        }
        else
        {
            mensajeError = res.Error;
        }
    }

    private void AbrirFormularioNuevo()
    {
        modelo = new CreateProfesionalRequest();
        mostrarFormulario = true;
        mensajeExito = null;
        mensajeError = null;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task GuardarProfesional()
    {
        var res = await ProfesionalRepository.CreateAsync(modelo);
        if (res.IsSuccess && res.Value != null)
        {
            mensajeExito = $"Profesional {res.Value.NombreCompleto} registrado con RETHUS {res.Value.NumeroRethus}.";
            mostrarFormulario = false;
            await CargarProfesionales();
        }
        else
        {
            mensajeError = res.Error;
        }
    }
}
