@inherits LayoutComponentBase

<div class="flex h-screen overflow-hidden bg-slate-50 font-sans text-slate-800 antialiased">
    <!-- Sidebar -->
    <aside class="w-72 flex-shrink-0 hidden md:block">
        <NavMenu />
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top Navigation Bar -->
        <header class="h-16 bg-white border-b border-slate-200/80 px-6 flex items-center justify-between shadow-xs z-10">
            <div class="flex items-center gap-4">
                <!-- IPS Location Badge -->
                <div class="flex items-center gap-2 bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700">
                    <i class="bi bi-geo-alt-fill text-sky-600"></i>
                    <span>IPS Central - Sede Bogotá</span>
                    <span class="bg-emerald-100 text-emerald-700 text-[10px] px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">Activa</span>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <!-- Role RBAC Indicator -->
                <div class="hidden sm:flex items-center gap-2 bg-sky-50 border border-sky-200/60 px-3 py-1.5 rounded-lg text-xs font-medium text-sky-800">
                    <i class="bi bi-shield-lock-fill text-sky-600"></i>
                    <span>Rol Actual: <strong class="font-bold text-sky-950">Recepcionista & Admisiones</strong></span>
                </div>

                <!-- Notifications & Help -->
                <button class="w-9 h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition-colors relative" title="Notificaciones del sistema">
                    <i class="bi bi-bell text-base"></i>
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-sky-500"></span>
                </button>
            </div>
        </header>

        <!-- Dynamic Body Page Content -->
        <main class="flex-1 overflow-y-auto p-6 md:p-8">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-4 right-4 z-50 bg-red-600 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3">
    <span>Ocurrió un error inesperado en la aplicación.</span>
    <a href="." class="underline font-bold text-white">Recargar</a>
    <span class="dismiss cursor-pointer text-lg font-bold">×</span>
</div>